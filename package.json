{
  "name": "ambit-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "lint": "biome check .",
    "format": "biome check --write .",
    "dashboard:dev": "pnpm --filter @ambit/dashboard dev",
    "dashboard:build": "pnpm --filter @ambit/dashboard build",
    "clean": "pnpm -r exec rm -rf dist *.tsbuildinfo",
    "deploy:account": "pnpm --filter @ambit/scripts deploy:account",
    "deploy:policy": "pnpm --filter @ambit/scripts deploy:policy",
    "test:testnet": "pnpm --filter @ambit/scripts test:testnet"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@types/node": "^22.20.5",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
